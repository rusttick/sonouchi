;; Every version is exact, so the same versions are used on every machine.
;; Only the owner changes this file. Ask before adding a dependency.
;; shadow-cljs reads the dependencies from here (shadow-cljs.edn, :deps).
;; The shadow-cljs version must match the one in package.json.
{:paths ["src"]

 :deps {org.clojure/clojure {:mvn/version "1.12.6"}
        no.cjohansen/replicant {:mvn/version "2026.07.1"}}

 :aliases
 {;; used by shadow-cljs.edn: the browser build, and the tests on Node
  :shadow {:extra-paths ["test"]
           :extra-deps {thheller/shadow-cljs {:mvn/version "3.5.7"}
                        org.clojure/test.check {:mvn/version "1.1.3"}}}

  ;; clojure -M:test    the tests on the JVM
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                      org.clojure/test.check {:mvn/version "1.1.3"}}
         :main-opts ["-m" "cognitect.test-runner"]}

  ;; clojure -M:lint --lint src test guard/src
  :lint {:extra-deps {clj-kondo/clj-kondo {:mvn/version "2026.08.04"}}
         :main-opts ["-m" "clj-kondo.main"]}

  ;; clojure -M:fmt check src test guard/src    (or fix)
  :fmt {:extra-deps {dev.weavejester/cljfmt {:mvn/version "0.16.6"}}
        :main-opts ["-m" "cljfmt.main"]}

  ;; clojure -M:guard    the project's own rules, in guard/rules.edn
  :guard {:extra-paths ["guard/src"]
          :extra-deps {clj-kondo/clj-kondo {:mvn/version "2026.08.04"}}
          :main-opts ["-m" "guard.main"]}

  ;; clj -M:dev    a JVM REPL with the tests on the classpath
  :dev {:extra-paths ["test"]
        :extra-deps {org.clojure/test.check {:mvn/version "1.1.3"}}}

  ;; clojure -M:nrepl    a JVM nREPL server on a free port, written to
  ;; .nrepl-port, for the pure core. Agents reach it through clojure-mcp.
  ;; The browser REPL is shadow-cljs's own nREPL (CONTRIBUTING.md).
  :nrepl {:extra-paths ["test"]
          :extra-deps {nrepl/nrepl {:mvn/version "1.8.0"}
                       org.clojure/test.check {:mvn/version "1.1.3"}}
          :main-opts ["-m" "nrepl.cmdline"]}

  ;; clojure -T:mcp start :config-profile :repl    the agents' REPL tool.
  ;; .mcp.json starts it; it starts the :nrepl alias above.
  :mcp {:replace-deps {io.github.bhauman/clojure-mcp
                       {:git/tag "v0.6.0" :git/sha "2b0213f"}}
        :ns-default clojure-mcp.main}}}
