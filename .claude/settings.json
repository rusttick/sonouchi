{
  "permissions": {
    "allow": [
      "Bash(bin/check)",
      "Bash(bin/fmt)",
      "Bash(clojure -M:test:*)",
      "Bash(clojure -M:lint:*)",
      "Bash(clojure -M:guard)",
      "Bash(npx shadow-cljs compile:*)",
      "Bash(npx shadow-cljs release:*)",
      "Bash(node target/node-test.js)",
      "Bash(npm ci)",
      "mcp__clojure-mcp__list_nrepl_ports",
      "mcp__clojure-mcp__paren_repair"
    ]
  },
  "enabledMcpjsonServers": ["clojure-mcp"],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__clojure-mcp__clojure_eval",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-eval.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-files.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-commands.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lint-edited.sh",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-on-stop.sh",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
